      <column caption='Type of Attraction' datatype='string' name='[Calculation_5782270145742753792]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([theme], &apos;Cultural &amp; Historical&apos;) THEN &apos;Cultural &amp; Historical&apos; &#10;ELSEIF CONTAINS([theme], &apos;Recreational &amp; Entertainment&apos;) THEN &apos;Recreational &amp; Entertainment&apos; &#10;ELSEIF CONTAINS([theme], &apos;Public Services &amp; Institutions&apos;) THEN &apos;Public Services &amp; Institutions&apos; &#10;ELSEIF CONTAINS([theme], &apos;Retail &amp; Shopping&apos;) THEN &apos;Retail &amp; Shopping&apos; &#10;END' />
      </column>
