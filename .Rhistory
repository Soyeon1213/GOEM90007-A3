library(shiny)
library(shinythemes)
ui <- navbarPage(
#theme = shinytheme("flatly"), # You can try other themes like "cerulean", "cosmo", etc.
theme = shinytheme("cosmo"),
title = "Melbourne City Guide",
# Overview Tab
tabPanel("Overview",
fluidRow(
column(12,
h2("Welcome to Melbourne City Guide"),
p("Here you will find information about transportation, attractions, restaurants, and accommodations in Melbourne.")
)
)
),
# Transportation Tab
tabPanel("Transportation",
fluidRow(
column(12,
h2("Transportation in Melbourne"),
p("Map of transportation will be integrated here.")
)
)
),
# Restaurant Tab
tabPanel("Restaurant",
fluidRow(
column(12,
h2("Top Restaurants in Melbourne"),
p("Map of restaurants will be integrated here.")
)
)
),
# Attractions Tab
tabPanel("Attractions",
fluidRow(
column(12,
h2("Top Attractions in Melbourne"),
p("Map and details of attractions will be integrated here.")
)
)
),
# Accommodations Tab
tabPanel("Accommodations",
fluidRow(
column(12,
h2("Accommodations in Melbourne"),
p("Map and details of accommodations will be integrated here.")
)
)
)
)
# Server logic
